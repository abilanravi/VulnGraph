## Used by docker-compose.yml — copy to .env before running `docker compose up`.

POSTGRES_USER=vulngraph
POSTGRES_PASSWORD=vulngraph
POSTGRES_DB=vulngraph

JWT_SECRET=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Set to "true" to populate demo data (demo@vulngraph.dev / password123, seeded as ADMIN) on
# first startup.
SEED_DB=false

# "production" enables environment-aware hardening (currently: sends Strict-Transport-Security).
# Leave as "development" unless this is served over HTTPS.
ENVIRONMENT=development

# Optional. If set, scan requests with a local `path` must resolve inside this directory —
# closes off scanning arbitrary server paths. Leave unset for local/single-operator use; set it
# in any deployment where the backend host also holds data other than what's meant to be scanned.
# SCAN_ROOT_DIR=/data/scan-targets
